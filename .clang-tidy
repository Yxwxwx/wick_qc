---
InheritParentConfig: false

Checks: >
  -*,
  google-*,
  -google-objc-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-unchecked-optional-access,
  clang-analyzer-*,
  performance-*,
  modernize-avoid-bind,
  modernize-make-unique,
  modernize-use-default-member-init,
  modernize-use-emplace,
  modernize-use-equals-default,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-transparent-functors,
  readability-identifier-naming,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-named-parameter,
  readability-redundant-*,
  readability-simplify-boolean-expr,
  readability-simplify-subscript-expr

WarningsAsErrors: '*'

HeaderFilterRegex: '(^|.*/)(src|tools)/.*'
# The supplied block2 implementation is a reference-only dependency.
ExcludeHeaderFilterRegex: '(^|.*/)((build|third_party|external|vendor)/.*|docs/wick\.hpp)'

FormatStyle: file

CheckOptions:
  # ---------------------------------------------------------------------------
  # Google naming conventions
  # ---------------------------------------------------------------------------

  # Namespaces: wick_qc::einsum
  readability-identifier-naming.NamespaceCase: lower_case

  # Types: TensorExpression, IndexSpace
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase

  # Type template parameters: typename TensorType
  readability-identifier-naming.TypeTemplateParameterCase: CamelCase
  readability-identifier-naming.TemplateTemplateParameterCase: CamelCase

  # Non-type template parameters follow variable naming.
  readability-identifier-naming.ValueTemplateParameterCase: lower_case

  # Variables and function parameters: tensor_count, output_indices
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case

  # Generic members are snake_case.
  readability-identifier-naming.MemberCase: lower_case

  # Class data members: indices_, expression_
  readability-identifier-naming.ClassMemberCase: lower_case
  readability-identifier-naming.ClassMemberSuffix: '_'
  readability-identifier-naming.PrivateMemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: '_'
  readability-identifier-naming.ProtectedMemberCase: lower_case
  readability-identifier-naming.ProtectedMemberSuffix: '_'

  # Global/static constants: kDefaultThreshold
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: 'k'

  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.StaticConstantPrefix: 'k'

  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: 'k'

  readability-identifier-naming.GlobalConstexprVariableCase: CamelCase
  readability-identifier-naming.GlobalConstexprVariablePrefix: 'k'

  readability-identifier-naming.StaticConstexprVariableCase: CamelCase
  readability-identifier-naming.StaticConstexprVariablePrefix: 'k'

  readability-identifier-naming.ClassConstexprCase: CamelCase
  readability-identifier-naming.ClassConstexprPrefix: 'k'

  # Enumerators: kActive, kExternal
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.EnumConstantPrefix: 'k'

  readability-identifier-naming.ScopedEnumConstantCase: CamelCase
  readability-identifier-naming.ScopedEnumConstantPrefix: 'k'

  # Macros are discouraged, but when necessary use UPPER_CASE.
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE

  # ---------------------------------------------------------------------------
  # Google checks
  # ---------------------------------------------------------------------------

  # Prefer std::int64_t/std::uint64_t style fixed-width integer names when the
  # google-runtime-int check diagnoses short/long/long long.
  google-runtime-int.SignedTypePrefix: 'int'
  google-runtime-int.UnsignedTypePrefix: 'uint'
  google-runtime-int.TypeSuffix: '_t'
