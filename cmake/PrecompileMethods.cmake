set(WICKQC_PRECOMPILE_MP "2;3;4" CACHE STRING "MP orders to generate at build time (empty disables MP)")
set(WICKQC_PRECOMPILE_CC "2;3" CACHE STRING "CC excitation ranks to generate at build time (2=CCSD, 3=CCSDT, 4=CCSDTQ)")
set(WICKQC_PRECOMPILE_CONVENTIONS "chemist" CACHE STRING "Integral conventions to precompile: chemist;physicist")

# Limit concurrent symbolic expansions, especially CCSDTQ, independently of -j.
set_property(GLOBAL APPEND PROPERTY JOB_POOLS wickqc_codegen_pool=1)
set(generated_dir "${CMAKE_CURRENT_BINARY_DIR}/generated")
set(registry "// Generated by CMake. Do not edit.\n#pragma once\n#include \"method/specification.hpp\"\n#include \"runtime/numeric.hpp\"\n#include <array>\n#include <span>\nnamespace wickqc::generated {\n")
set(dispatch "")
set(methods "")
set(generated_sources "")
foreach(convention IN LISTS WICKQC_PRECOMPILE_CONVENTIONS)
  if(NOT convention MATCHES "^(chemist|physicist)$")
    message(FATAL_ERROR "Invalid precompiled integral convention '${convention}'")
  endif()
endforeach()
list(REMOVE_DUPLICATES WICKQC_PRECOMPILE_CONVENTIONS)
foreach(family IN ITEMS MP CC)
  string(TOLOWER "${family}" family_lower)
  if(family STREQUAL "MP")
    set(family_enum kMP)
  else()
    set(family_enum kCC)
  endif()
  list(REMOVE_DUPLICATES WICKQC_PRECOMPILE_${family})
  foreach(order IN LISTS WICKQC_PRECOMPILE_${family})
    if(NOT order MATCHES "^[234]$")
      message(FATAL_ERROR "WICKQC_PRECOMPILE_${family} accepts 2;3;4, got '${order}'")
    endif()
    foreach(convention IN LISTS WICKQC_PRECOMPILE_CONVENTIONS)
      if(convention STREQUAL "chemist")
        set(convention_enum kChemist)
      else()
        set(convention_enum kPhysicist)
      endif()
      set(name "${family_lower}${order}_${convention}")
      set(source "${generated_dir}/${name}.generated.cpp")
      add_custom_command(OUTPUT "${source}"
        COMMAND generate_cpp "${family_lower}" "${order}" "${convention}" "${name}" "${source}"
        DEPENDS generate_cpp
        COMMENT "Generating spatial ${family_lower}${order} (${convention}) numeric C++"
        JOB_POOL wickqc_codegen_pool
        VERBATIM)
      list(APPEND generated_sources "${source}")
      string(APPEND registry "const runtime::NumericKernel& Kernel_${name}();\n")
      set(spec "method::SpatialMethod{method::SpatialFamily::${family_enum}, ${order}, method::IntegralConvention::${convention_enum}}")
      string(APPEND dispatch "  if (requested == ${spec}) {\n    return &generated::Kernel_${name}();\n  }\n")
      string(APPEND methods "  ${spec},\n")
    endforeach()
  endforeach()
endforeach()
list(LENGTH generated_sources method_count)
string(APPEND registry "} // namespace wickqc::generated\nnamespace wickqc::runtime {\ninline const NumericKernel* FindPrecompiled(method::SpatialMethod requested) {\n${dispatch}  return nullptr;\n}\ninline std::span<const method::SpatialMethod> PrecompiledMethods() {\n  static constexpr std::array<method::SpatialMethod, ${method_count}> kMethods{{\n${methods}  }};\n  return kMethods;\n}\n} // namespace wickqc::runtime\n")
file(GENERATE OUTPUT "${generated_dir}/precompiled.generated.hpp" CONTENT "${registry}")
if(generated_sources)
  add_library(wickqc_precompiled ${generated_sources})
  target_link_libraries(wickqc_precompiled PUBLIC wickqc_numeric)
  target_include_directories(wickqc_precompiled PUBLIC "${generated_dir}")
else()
  add_library(wickqc_precompiled INTERFACE)
  target_link_libraries(wickqc_precompiled INTERFACE wickqc_numeric)
  target_include_directories(wickqc_precompiled INTERFACE "${generated_dir}")
endif()
