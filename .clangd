CompileFlags:
  Add:
    - "-I/usr/lib/gcc/x86_64-linux-gnu/13/include"
    - "-std=c++20"
  CompilationDatabase: build
  Compiler: /software/Applications/gcc/13.3.0/bin/c++
  Remove:
    - -Winvalid-pch

Index:
  Background: Build

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict

---
# This adapter requires the TBLIS dependency flags even in a BLAS workspace.
If:
  PathMatch: src/backend/tblis\.hpp
CompileFlags:
  CompilationDatabase: build/tblis
